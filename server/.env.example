# Copy to server/.env to override defaults.
PORT=4000
# SQLite file relative to server/, or :memory: for a throwaway database.
DATABASE_PATH=data/stocksphere.db
# Session expires after this many idle minutes, and after SESSION_MAX_HOURS regardless of activity.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=168
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
# Number of reverse-proxy hops to trust for client IPs (0 = none).
TRUST_PROXY=0
# Price source: yahoo (real NSE/BSE prices from Yahoo Finance, ~15 min delayed; personal use only)
# or simulated (built-in random-walk market that never closes). Falls back to simulated if Yahoo is unreachable.
MARKET_DATA=yahoo
# How often live quotes are refreshed while the exchange is open.
LIVE_POLL_MS=15000
# Simulated prices (all securities with MARKET_DATA=simulated; IPO listings and admin-added securities otherwise).
MARKET_SIMULATION=true
TICK_INTERVAL_MS=2000
# Seed demo users and data on first start.
SEED_DEMO_DATA=true
RATE_LIMIT=true
